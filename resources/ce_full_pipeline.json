# CE (Community Edition) Full Pipeline Job
# Single-node cluster, DBR 12.x, no Unity Catalog, Hive metastore
# Run: databricks jobs create --json-file resources/ce_full_pipeline.yml

{
  "name": "credit-card-defaulter-ce-full-pipeline",
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "job_clusters": [
    {
      "job_cluster_key": "ce-cluster",
      "new_cluster": {
        "spark_version": "12.2.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 0,
        "spark_conf": {
          "spark.databricks.clusterUsageTags.clusterPurpose": "pipeline",
          "spark.databricks.clusterUsageTags.project": "credit_card_defaulter",
          "spark.sql.sources.partitionOverwriteMode": "dynamic",
          "spark.sql.adaptive.enabled": "true",
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        }
      }
    }
  ],
  "environment_variables": {
    "CATALOG": "default",
    "LANDING_PATH": "dbfs:/FileStore/credit_card_defaulter/landing",
    "CHECKPOINT_PATH": "dbfs:/FileStore/credit_card_defaulter/checkpoints",
    "WATERMARK_TABLE": "default.control_watermark",
    "PIPELINE_LOGS_TABLE": "default.bronze_pipeline_logs",
    "DQ_QUARANTINE_TABLE": "default.bronze_dq_quarantine",
    "DQ_SCORES_TABLE": "default.silver_dq_scores",
    "PROFILE": "community"
